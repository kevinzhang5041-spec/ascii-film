#!/usr/bin/env bash
# ./ascii - render everything in input/ as ASCII art. Run ./ascii --help, or see README.md.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if [[ "${1:-}" == "setup" ]]; then
  exec "$HERE/setup.sh"
fi
if [[ ! -x "$HERE/.venv/bin/python" ]] || ! command -v ffmpeg >/dev/null; then
  "$HERE/setup.sh"
fi
exec "$HERE/.venv/bin/python" "$HERE/studio.py" "$@"
